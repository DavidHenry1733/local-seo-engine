# ============================================================
# LOCAL SEO CONTENT GENERATOR — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
SESSION_SECRET=change-this-to-a-long-random-string-min-32-chars

# ── OpenAI — Content Generation ──────────────────────────────
# Used for: page content generation, section optimisation,
#           keyword suggestions, AI citation optimisation,
#           social post generation, brand import, scoring.
#
# On Replit: AI_INTEGRATIONS_OPENAI_* (proxy — no billing needed)
# On VPS:    Set OPENAI_API_KEY directly (standard OpenAI billing)
OPENAI_API_KEY=sk-...

# ── Ideogram — AI Image Generation ───────────────────────────
# Used for: generating hero, support, trust, and conversion images.
# Obtain from: https://ideogram.ai/manage-api
IDEOGRAM_API_KEY=...

# ── FTP / SFTP Deployment ────────────────────────────────────
# Used for: uploading generated pages + sitemaps to the live server.
# Set these to the FTP credentials for the target hosting account.
DEPLOY_USERNAME=ftp_username
DEPLOY_PASSWORD=ftp_password

# ── Google Search Console — Service Account ──────────────────
# Used for: indexing status checks, URL inspection API.
# Create a service account in Google Cloud Console, grant it
# GSC property access, and paste the full JSON here as one line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Google Search Console — OAuth (keyword/index tracking) ───
# Used for: keyword position tracking and index status via GSC API.
# Obtain from: Google Cloud Console > APIs & Services > Credentials
GSC_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GSC_OAUTH_CLIENT_SECRET=GOCSPX-...
GSC_OAUTH_REFRESH_TOKEN=1//...

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# The app uses Drizzle ORM. Run `pnpm db:push` after first launch.
# Most application data is stored in JSON config files (see below),
# but the DB is required for session storage and user accounts.
DATABASE_URL=postgresql://user:password@localhost:5432/localseo

# ── Image Quota ──────────────────────────────────────────────
# Maximum AI-generated images allowed per calendar month.
# Prevents runaway Ideogram API spend.
MAX_MONTHLY_SERVER_IMAGES=200

# ── App Domain (VPS — remove Replit vars below) ──────────────
# On VPS set this to your actual app domain so CORS and
# absolute URL generation work correctly.
# APP_DOMAIN=https://app.localseongine.com

# ── Replit-specific (not needed on VPS) ──────────────────────
# REPLIT_DEV_DOMAIN=<auto-set by Replit>
# REPLIT_DOMAINS=<auto-set by Replit>
# AI_INTEGRATIONS_OPENAI_API_KEY=<Replit AI proxy key>
# AI_INTEGRATIONS_OPENAI_BASE_URL=<Replit AI proxy base URL>
